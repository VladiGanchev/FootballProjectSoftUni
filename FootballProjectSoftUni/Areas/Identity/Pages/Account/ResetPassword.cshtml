@page
@model ResetPasswordModel
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["RPResetPassword"].Value;
}

<section class="auth-solo">
    <svg class="auth-solo__ball" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <circle cx="50" cy="50" r="46" />
        <polygon points="50,33 66,45 60,64 40,64 34,45" />
        <path d="M50 33 L50 6 M66 45 L92 36 M60 64 L76 86 M40 64 L24 86 M34 45 L8 36" />
    </svg>

    <div class="auth-solo__card" data-reveal>
        <div class="auth-badge auth-badge--pitch" aria-hidden="true">
            <i class="bi bi-shield-lock-fill auth-badge__icon"></i>
        </div>

        <div class="auth-solo__head">
            <span class="tg-sticker auth-solo__sticker" style="--rot:-3deg">@Localizer["AuthNewSeason"]</span>

            <ol class="auth-pass">
                <li class="is-done">
                    <span class="auth-pass__dot" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                    <span>@Localizer["FPEmail"]</span>
                </li>
                <li class="is-done">
                    <span class="auth-pass__dot" aria-hidden="true"><i class="bi bi-check-lg"></i></span>
                    <span>@Localizer["AuthStepInbox"]</span>
                </li>
                <li class="is-current" aria-current="step">
                    <span class="auth-pass__dot" aria-hidden="true"><i class="bi bi-key-fill"></i></span>
                    <span>@Localizer["RPNewPassword"]</span>
                </li>
                <li>
                    <span class="auth-pass__dot" aria-hidden="true"><i class="bi bi-trophy-fill"></i></span>
                    <span>@Localizer["AuthStepDone"]</span>
                </li>
            </ol>

            <h1 class="auth-solo__title">@Localizer["RPResetPassword"]</h1>
            <p class="auth-solo__sub">@Localizer["RPChooseNewPass"]</p>
        </div>

        <form method="post" class="auth-form">
            <div asp-validation-summary="ModelOnly" class="auth-summary alert alert-danger" role="alert"></div>

            <input asp-for="Input.Code" type="hidden" />

            <div class="auth-field">
                <label asp-for="Input.Email" class="auth-label">@Localizer["RPEmail"]</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-envelope-fill auth-input-icon" aria-hidden="true"></i>
                    <input asp-for="Input.Email" class="form-control auth-input" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                </div>
                <span asp-validation-for="Input.Email" class="auth-error text-danger"></span>
            </div>

            <div class="auth-field">
                <label asp-for="Input.Password" class="auth-label">@Localizer["RPNewPassword"]</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-lock-fill auth-input-icon" aria-hidden="true"></i>
                    <input asp-for="Input.Password" class="form-control auth-input auth-input--pw" autocomplete="new-password" aria-required="true" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" />
                    <button type="button" class="auth-eye" data-auth-toggle aria-pressed="false" aria-label="@Localizer["AuthShowPassword"]" title="@Localizer["AuthShowPassword"]">
                        <i class="bi bi-eye-fill" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.Password" class="auth-error text-danger"></span>
                <p class="auth-hint">
                    <i class="bi bi-info-circle-fill" aria-hidden="true"></i>
                    <span>@Localizer["AuthPasswordHint"]</span>
                </p>
            </div>

            <div class="auth-field">
                <label asp-for="Input.ConfirmPassword" class="auth-label">@Localizer["RPConfirmPassword"]</label>
                <div class="auth-input-wrap">
                    <i class="bi bi-check2-circle auth-input-icon" aria-hidden="true"></i>
                    <input asp-for="Input.ConfirmPassword" class="form-control auth-input auth-input--pw" autocomplete="new-password" aria-required="true" placeholder="&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;" />
                    <button type="button" class="auth-eye" data-auth-toggle aria-pressed="false" aria-label="@Localizer["AuthShowPassword"]" title="@Localizer["AuthShowPassword"]">
                        <i class="bi bi-eye-fill" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="auth-error text-danger"></span>
            </div>

            <button type="submit" class="btn btn-accent btn-lg auth-btn">
                <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                <span>@Localizer["RPReset"]</span>
            </button>
        </form>

        <div class="auth-foot auth-foot--center">
            <a class="auth-back" asp-page="./Login">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                <span>@Localizer["RPBackToLogin"]</span>
            </a>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.querySelectorAll('[data-auth-toggle]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var input = btn.parentElement.querySelector('input');
                if (!input) { return; }
                var show = input.type === 'password';
                input.type = show ? 'text' : 'password';
                btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                var icon = btn.querySelector('i');
                if (icon) { icon.className = show ? 'bi bi-eye-slash-fill' : 'bi bi-eye-fill'; }
            });
        });
    </script>
}
