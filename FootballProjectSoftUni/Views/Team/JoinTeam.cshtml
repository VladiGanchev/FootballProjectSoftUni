@using FootballProjectSoftUni.Core.Models.Team
@model TeamRegistrationViewModel
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer


@{
    ViewData["Title"] = Localizer["TpJtTitle"].Value;

    // 1-4-3-2 shape on a landscape pitch (attacking right). Index i -> shirt i + 1 -> Players[i]
    var spots = new (int X, int Y)[]
    {
        (7, 50),
        (24, 80), (24, 20), (20, 62), (20, 38),
        (40, 50), (55, 77), (55, 23),
        (75, 63), (75, 37)
    };
}

@* ============ HEAD: poster title + live scoreboard ============ *@
<header class="tp-tactics__head">
    <div>
        <span class="tg-kicker">@Localizer["JTPlayers"]</span>
        <h1 class="tp-giant" data-split>@Localizer["TpJtTitle"]</h1>
        <p class="tp-lead">@Localizer["JTEnter"]</p>
    </div>

    <dl class="tp-scoreboard" aria-hidden="true">
        <div>
            <dt>@Localizer["JTPlayers"]</dt>
            <dd><span id="tp-score-value">0</span><small> / 10</small></dd>
        </div>
    </dl>
</header>

@* Alerts *@
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
        @TempData["ErrorMessage"]
    </div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger mb-4">
        <div asp-validation-summary="All"></div>
    </div>
}

<form asp-action="JoinTeam" method="post">

    @* Team name *@
    <div class="tp-teamname">
        <span class="tg-icon-tile tg-icon-tile--coral" aria-hidden="true"><i class="bi bi-shield-fill"></i></span>
        <div class="tp-teamname__field">
            <label asp-for="TeamName" class="form-label">@Localizer["JTTeamName"]</label>
            <input asp-for="TeamName" class="form-control form-control-lg" autocomplete="off" />
            <span asp-validation-for="TeamName" class="text-danger small"></span>
        </div>
    </div>

    <div class="tp-tactics__grid">

        @* Tactics board: dots mirror the inputs *@
        <div class="tp-board">
            <div class="tp-board__pitch" aria-hidden="true">
                <svg class="tg-pitch-lines" viewBox="0 0 100 64" preserveAspectRatio="none">
                    <rect x="2" y="2" width="96" height="60" rx="1" />
                    <line x1="50" y1="2" x2="50" y2="62" />
                    <circle cx="50" cy="32" r="8" />
                    <rect x="2" y="17" width="13" height="30" />
                    <rect x="2" y="25" width="5" height="14" />
                    <rect x="85" y="17" width="13" height="30" />
                    <rect x="93" y="25" width="5" height="14" />
                </svg>

                <span class="tp-board__team">
                    <i class="bi bi-shield-fill"></i>
                    <span id="tp-team-out" data-empty="@Localizer["JTTeamName"]">@Localizer["JTTeamName"]</span>
                </span>

                @for (int i = 0; i < spots.Length; i++)
                {
                    <span class="tp-spot" data-spot="@i" style="--x:@(spots[i].X)%;--y:@(spots[i].Y)%">
                        <span class="tp-spot__dot">@(i + 1)</span>
                        <span class="tp-spot__name"></span>
                    </span>
                }
            </div>

            <div class="tp-squad">
                <div class="tp-squadbar" aria-hidden="true">
                    @for (int i = 0; i < 10; i++)
                    {
                        <span></span>
                    }
                </div>
                <span class="tg-chip" id="tp-ready" aria-live="polite"
                      data-min="@Localizer["TpJtMin"]"
                      data-ready="@Localizer["TpJtReady"]">@Localizer["TpJtMin"]</span>
            </div>
        </div>

        @* Team sheet *@
        <section class="tp-sheet" aria-labelledby="tp-sheet-title">
            <div class="tp-sheet__head">
                <h2 class="tp-h2" id="tp-sheet-title"><i class="bi bi-people-fill" aria-hidden="true"></i>@Localizer["JTPlayers"]</h2>
                <span class="tg-chip tg-chip--green" id="tp-count" aria-live="polite">
                    <i class="bi bi-person-check-fill" aria-hidden="true"></i>
                    <span id="tp-count-value">0</span> / 10
                </span>
                <span class="visually-hidden">@Localizer["JT10"]</span>
            </div>

            <ol class="tp-sheet__list">
                @for (int i = 0; i < 10; i++)
                {
                    <li class="tp-player">
                        <span class="tp-player__num" aria-hidden="true">@(i + 1)</span>

                        <div class="tp-player__field">
                            <label asp-for="@Model.Players[i].Name" class="visually-hidden">
                                @Localizer["JTPlayer"] @(i + 1)
                            </label>

                            <input asp-for="@Model.Players[i].Name"
                                   class="form-control"
                                   data-slot="@i"
                                   autocomplete="off"
                                   placeholder="@Localizer["JTPlayer"] @(i + 1)" />

                            <span asp-validation-for="@Model.Players[i].Name" class="text-danger small"></span>
                        </div>
                    </li>
                }
            </ol>

            <div class="tg-form-actions">
                <button type="submit" class="btn btn-accent btn-lg">
                    <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
                    @Localizer["JTRegister"]
                </button>
            </div>
        </section>

    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var inputs = document.querySelectorAll("input[data-slot]");
            var spots = document.querySelectorAll("[data-spot]");
            var segments = document.querySelectorAll(".tp-squadbar span");
            var counter = document.getElementById("tp-count-value");
            var score = document.getElementById("tp-score-value");
            var ready = document.getElementById("tp-ready");
            var teamIn = document.getElementById("TeamName");
            var teamOut = document.getElementById("tp-team-out");

            function spotFor(i) { return document.querySelector('[data-spot="' + i + '"]'); }

            function shortName(value) {
                var parts = value.split(/\s+/).filter(Boolean);
                return parts.length > 1 ? parts[parts.length - 1] : (parts[0] || "");
            }

            function refresh() {
                var filled = 0;
                inputs.forEach(function (input) {
                    var value = input.value.trim();
                    var isFilled = value.length > 0;
                    var spot = spotFor(input.getAttribute("data-slot"));
                    var row = input.closest(".tp-player");
                    if (isFilled) { filled++; }
                    if (row) { row.classList.toggle("is-filled", isFilled); }
                    if (spot) {
                        spot.classList.toggle("is-filled", isFilled);
                        var label = spot.querySelector(".tp-spot__name");
                        if (label) { label.textContent = isFilled ? shortName(value) : ""; }
                    }
                });
                segments.forEach(function (seg, idx) { seg.classList.toggle("is-on", idx < filled); });
                if (counter) { counter.textContent = filled; }
                if (score) { score.textContent = filled; }
                if (ready) {
                    var ok = filled >= 6;
                    var text = ok ? ready.getAttribute("data-ready") : ready.getAttribute("data-min");
                    if (ready.textContent !== text) { ready.textContent = text; }
                    ready.classList.toggle("is-ready", ok);
                }
            }

            function setActive(i) {
                spots.forEach(function (s) { s.classList.toggle("is-active", s.getAttribute("data-spot") === i); });
            }

            function syncTeam() {
                if (teamIn && teamOut) { teamOut.textContent = teamIn.value.trim() || teamOut.getAttribute("data-empty"); }
            }

            inputs.forEach(function (input) {
                input.addEventListener("input", refresh);
                input.addEventListener("focus", function () { setActive(input.getAttribute("data-slot")); });
                input.addEventListener("blur", function () { setActive(null); });
            });

            spots.forEach(function (spot) {
                spot.addEventListener("click", function () {
                    var target = document.querySelector('input[data-slot="' + spot.getAttribute("data-spot") + '"]');
                    if (target) { target.focus(); }
                });
            });

            if (teamIn) { teamIn.addEventListener("input", syncTeam); }

            refresh();
            syncTeam();
        });
    </script>
}
