@using FootballProjectSoftUni.Core.Models.City
@using FootballProjectSoftUni.Extensions
@using X.PagedList
@model IPagedList<CityViewModel>
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["DCities"].Value;
    ViewData["FullWidth"] = true;

    var offset = (Model.PageNumber - 1) * Model.PageSize;
    var pageCount = Math.Max(1, Model.PageCount);
}

<div class="container-xl cp-page">

    @* Alerts *@
    @if (TempData["ErrorMessage"] != null || TempData["PaymentMessage"] != null)
    {
        <div class="cp-alerts">
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>
                    @TempData["ErrorMessage"]
                </div>
            }

            @if (TempData["PaymentMessage"] != null)
            {
                var type = TempData["PaymentType"]?.ToString() ?? "info";
                var pendingOrder = TempData["PaymentPendingOrder"] as int?;

                @* A payment Stripe hasn't confirmed yet: the page checks it by itself and shows the result. *@
                <div class="alert alert-@type mb-0" role="@(pendingOrder.HasValue ? "status" : "alert")"
                     data-payment-poll="@(pendingOrder.HasValue ? Url.Action("PaymentStatus", "City", new { orderId = pendingOrder }) : null)"
                     data-paid-text="@(pendingOrder.HasValue ? Localizer["PaymentSuccessMessage"].Value : null)"
                     data-slow-text="@(pendingOrder.HasValue ? Localizer["PaymentSlowMessage"].Value : null)">
                    <i class="bi bi-info-circle-fill me-2" aria-hidden="true"></i>
                    <span data-payment-text>@TempData["PaymentMessage"]</span>
                </div>
            }
        </div>
    }

    @* Poster hero + command bar *@
    <section class="cp-hero" aria-labelledby="citiesTitle">
        <div class="cp-hero__top">

            @if (User.IsAdmin())
            {
                <div class="cp-admin">
                    <a asp-controller="City" asp-action="AddCity" class="btn btn-accent btn-sm">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>@Localizer["DAddCity"]
                    </a>
                    <a asp-controller="City" asp-action="UpdateCityLeaders" class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-arrow-repeat" aria-hidden="true"></i>@Localizer["DUCL"]
                    </a>
                    <a asp-controller="City" asp-action="ChangePicture" class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-image-fill" aria-hidden="true"></i>@Localizer["PicChangeShort"]
                    </a>
                </div>
            }
        </div>

        <h1 class="cp-mega" id="citiesTitle" data-split>
            @Localizer["DCities"]
            <sup class="cp-mega__sup">@Model.TotalItemCount</sup>
        </h1>

        <div class="cp-stamp" aria-hidden="true">
            <svg viewBox="0 0 200 200" focusable="false">
                <defs>
                    <path id="cpStampPath" d="M100,100 m-80,0 a80,80 0 1,1 160,0 a80,80 0 1,1 -160,0" />
                </defs>
                <text>
                    <textPath href="#cpStampPath" textLength="492" lengthAdjust="spacing">Tournament Galaxy &#8226; @Localizer["DCities"] &#8226; @BgTime.Today.Year &#8226;</textPath>
                </text>
            </svg>
            <i class="bi bi-geo-alt-fill"></i>
        </div>

        <p class="cp-lead">@Localizer["CPCitiesLead"]</p>

        <form method="get" action="@Url.Action("Search")" class="cp-cmd" role="search">
            <i class="bi bi-search cp-cmd__icon" aria-hidden="true"></i>
            <input type="text"
                   id="citySearch"
                   class="cp-cmd__input"
                   name="searchString"
                   autocomplete="off"
                   placeholder="@Localizer["AllSearch"]"
                   aria-label="@Localizer["AllSearch"]"
                   aria-keyshortcuts="/" />
            <button class="btn btn-primary cp-cmd__go" type="submit" aria-label="@Localizer["AllSearch"]">
                <span class="cp-cmd__go-text">@Localizer["AllSearch"]</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </button>
        </form>
    </section>

    @* Editorial index *@
    @if (Model.Any())
    {
        <div class="cp-index-head">
            <span>&#8470; &middot; @Localizer["UPLCity"]</span>
            <span class="cp-index-head__swipe"><i class="bi bi-arrow-left-right" aria-hidden="true"></i>@Localizer["CPSwipe"]</span>
            <span>@Localizer["CPPage"] @Model.PageNumber / @pageCount</span>
        </div>

        <ol class="cp-index" data-hover-reveal aria-label="@Localizer["DCities"]">
            @{ var n = 0; }
            @foreach (var city in Model)
            {
                n++;
                var no = (offset + n).ToString("00");

                <li class="cp-row" data-name="@city.Name" data-reveal>
                    <a class="cp-row__main"
                       data-img="@CoverPictureStore.Small(city.ImageUrl)"
                       asp-controller="Tournament"
                       asp-action="CityTournaments"
                       asp-route-id="@city.Id">
                        <span class="cp-row__num" aria-hidden="true">@no</span>
                        <span class="cp-row__photo" aria-hidden="true">
                            <i class="bi bi-geo-alt-fill"></i>
                            <img src="@CoverPictureStore.Small(city.ImageUrl)" data-full="@city.ImageUrl" alt="" loading="lazy" draggable="false" data-hide-on-error />
                        </span>
                        <span class="cp-row__name">@city.Name</span>
                    </a>

                    <div class="cp-row__actions">
                        <a asp-controller="Tournament"
                           asp-action="CityTournaments"
                           asp-route-id="@city.Id"
                           class="btn btn-primary btn-sm cp-row__go">
                            <i class="bi bi-trophy-fill" aria-hidden="true"></i>@Localizer["AllTournaments"]
                        </a>

                        <a asp-controller="City"
                           asp-action="GetBestTeams"
                           asp-route-id="@city.Id"
                           class="btn btn-outline-dark btn-sm cp-row__leaders">
                            <i class="bi bi-bar-chart-fill" aria-hidden="true"></i>@Localizer["AllLeaders"]
                        </a>
                    </div>
                </li>
            }
        </ol>
    }
    else
    {
        <div class="tg-empty cp-empty">
            <span class="tg-empty__icon"><i class="bi bi-geo-alt" aria-hidden="true"></i></span>
            <h5>@Localizer["NoCity"]</h5>
        </div>
    }

    @* Pagination *@
    @if (Model.PageCount > 1)
    {
        <nav class="cp-pager" aria-label="Page navigation">
            <div class="cp-pager__label" aria-hidden="true">
                <small>@Localizer["CPPage"]</small>
                <b>@Model.PageNumber</b>
                <span>/ @Model.PageCount</span>
            </div>

            <ul class="pagination">
                @{
                    var nextPage = Model.PageNumber + 1;
                    var previousPage = Model.PageNumber - 1;
                }

                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" href="@Url.Action("All", new { page = previousPage })" tabindex="-1" aria-label="Previous">
                        <i class="bi bi-chevron-left" aria-hidden="true"></i>
                    </a>
                </li>

                @for (int i = 1; i <= Model.PageCount; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" href="@Url.Action("All", new { page = i })" aria-current="@(i == Model.PageNumber ? "page" : null)">@i</a>
                    </li>
                }

                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" href="@Url.Action("All", new { page = nextPage })" aria-label="Next">
                        <i class="bi bi-chevron-right" aria-hidden="true"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }
</div>

@section Scripts {
    <script>
        // After a payment: ask every 3 seconds (for up to a minute) whether Stripe has confirmed it.
        (function () {
            var box = document.querySelector('[data-payment-poll]');
            if (!box || !window.fetch) { return; }
            var url = box.getAttribute('data-payment-poll');
            var text = box.querySelector('[data-payment-text]');
            var tries = 0;

            function show(kind, message) {
                box.classList.remove('alert-info');
                box.classList.add('alert-' + kind);
                text.textContent = message;
            }

            function check() {
                tries++;
                fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.ok ? r.json() : null; })
                    .then(function (s) {
                        if (s && s.paid) { show('success', box.getAttribute('data-paid-text')); return; }
                        if (tries < 20) { setTimeout(check, 3000); } else { show('info', box.getAttribute('data-slow-text')); }
                    })
                    .catch(function () { if (tries < 20) { setTimeout(check, 3000); } else { show('info', box.getAttribute('data-slow-text')); } });
            }

            setTimeout(check, 2000);
        })();

        (function () {
            var input = document.getElementById('citySearch');
            if (!input) { return; }
            var rows = Array.prototype.slice.call(document.querySelectorAll('.cp-row[data-name]'));

            // "/" focuses the command bar (unless the visitor is already typing somewhere)
            document.addEventListener('keydown', function (e) {
                if (e.key !== '/' || e.ctrlKey || e.metaKey || e.altKey) { return; }
                var t = e.target;
                if (t && (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName))) { return; }
                e.preventDefault();
                input.focus();
                input.select();
            });

            input.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') { input.blur(); }
            });

            // Live dim of rows on this page that do not match (Enter still searches all cities)
            input.addEventListener('input', function () {
                var q = input.value.trim().toLowerCase();
                rows.forEach(function (row) {
                    var name = (row.getAttribute('data-name') || '').toLowerCase();
                    row.classList.toggle('is-dim', q.length > 0 && name.indexOf(q) !== 0);
                });
            });
        })();
    </script>
}
