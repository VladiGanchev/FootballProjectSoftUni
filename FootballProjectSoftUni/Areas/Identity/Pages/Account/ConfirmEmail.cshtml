@page
@model ConfirmEmailModel
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["CETitle"].Value;
}

<section class="auth-solo">
    <svg class="auth-solo__ball" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <circle cx="50" cy="50" r="46" />
        <polygon points="50,33 66,45 60,64 40,64 34,45" />
        <path d="M50 33 L50 6 M66 45 L92 36 M60 64 L76 86 M40 64 L24 86 M34 45 L8 36" />
    </svg>

    <div class="auth-solo__card auth-solo__card--center" data-reveal>
        @if (Model.Confirmed)
        {
            <div class="auth-badge auth-badge--pitch" aria-hidden="true">
                <i class="bi bi-check-lg auth-badge__icon"></i>
                <span class="auth-confetti">
                    <span style="--x:-80px;--y:-22px;--r:-24deg;--c:var(--tg-coral)"></span>
                    <span style="--x:-62px;--y:-56px;--r:18deg;--c:var(--tg-sun)"></span>
                    <span style="--x:-22px;--y:-70px;--r:-10deg;--c:var(--tg-mint)"></span>
                    <span style="--x:24px;--y:-70px;--r:32deg;--c:var(--tg-lilac)"></span>
                    <span style="--x:64px;--y:-52px;--r:-30deg;--c:var(--tg-coral)"></span>
                    <span style="--x:84px;--y:-14px;--r:12deg;--c:var(--tg-sun)"></span>
                    <span style="--x:-92px;--y:20px;--r:40deg;--c:var(--tg-mint)"></span>
                    <span style="--x:92px;--y:26px;--r:-44deg;--c:var(--tg-lilac)"></span>
                </span>
            </div>

            <div class="auth-solo__head">
                <span class="tg-sticker tg-sticker--coral auth-solo__sticker" style="--rot:-4deg">@Localizer["AuthGoal"]</span>
                <h1 class="auth-solo__title">@Localizer["CEConfirmedTitle"]</h1>
                <p class="auth-solo__sub">@Localizer["CEConfirmedText"]</p>
            </div>
        }
        else
        {
            <div class="auth-badge auth-badge--coral" aria-hidden="true">
                <i class="bi bi-x-lg auth-badge__icon"></i>
            </div>

            <div class="auth-solo__head">
                <h1 class="auth-solo__title">@Localizer["CEFailedTitle"]</h1>
                <p class="auth-solo__sub">@Localizer["CEFailedText"]</p>
            </div>
        }

        <a href="~/" class="btn btn-primary btn-lg auth-btn">
            <i class="bi bi-house-door-fill" aria-hidden="true"></i>
            <span>@Localizer["CEToSite"]</span>
        </a>

        @if (!Model.Confirmed)
        {
            <div class="auth-foot auth-foot--center">
                <a class="auth-back" asp-page="./ResendEmailConfirmation">
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                    <span>@Localizer["CENewLink"]</span>
                </a>
            </div>
        }
    </div>
</section>
