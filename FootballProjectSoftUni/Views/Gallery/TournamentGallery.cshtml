@using FootballProjectSoftUni.Extensions
@model List<string>
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer
@inject Microsoft.Extensions.Options.IOptions<FootballProjectSoftUni.Core.Models.Settings.SiteSettings> SiteOptions


@{
    ViewBag.Title = "Tournament Gallery";
    int tournamentId = ViewBag.TournamentId;
    bool isAdmin = User.Identity.IsAuthenticated && User.IsAdmin();
    bool hasImages = Model != null && Model.Any();
    int photoIndex = 0;

    // Scattered collage: a repeating set of small rotations for the polaroids and their tape.
    var rotations = new[] { "-3deg", "2deg", "-1.5deg", "3.5deg", "-2.5deg", "1deg", "2.5deg", "-3.5deg" };
    var tapes = new[] { "-4deg", "3deg", "-2deg", "5deg", "1deg", "-5deg" };
}

<section>

    @* Alerts *@
    @if (TempData["Success"] != null || TempData["Error"] != null)
    {
        <div class="tn-alerts">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    @TempData["Error"]
                </div>
            }
        </div>
    }

    <header class="tn-gal-head">
        <div>
            <h1 class="tn-gal-head__title" data-split>@Localizer["TGPictures"].Value.Trim().TrimEnd('.')</h1>
        </div>

        <div class="tn-gal-head__side">
            @if (hasImages)
            {
                <span class="tg-sticker tg-sticker--mint tn-gal-head__count" style="--rot:6deg">
                    <i class="bi bi-camera-fill" aria-hidden="true"></i><span class="tg-num" data-count="@Model.Count">@Model.Count</span>
                </span>
            }

            @if (isAdmin)
            {
                <a asp-controller="Gallery"
                   asp-action="UploadPictures"
                   asp-route-id="@tournamentId"
                   class="btn btn-accent">
                    <i class="bi bi-cloud-upload-fill" aria-hidden="true"></i>@Localizer["CTUpload"]
                </a>
            }
        </div>
    </header>

    @if (!hasImages)
    {
        <div class="tn-wall">
            <div class="tn-gal-empty">
                <div class="tn-gal-empty__frame" aria-hidden="true"><span><i class="bi bi-camera"></i></span></div>
                <h2>@Localizer["TGNoImages"]</h2>
                <p>@Localizer["TGNotYet"]</p>
            </div>
        </div>
    }
    else
    {
        <div class="tn-wall">
            <div class="tn-collage"
                 data-tn-gallery
                 data-label-close="@Localizer["TNClose"]"
                 data-label-prev="@Localizer["TNPrev"]"
                 data-label-next="@Localizer["TNNext"]"
                 data-label-confirm="@Localizer["DCCConfirmDeletion"]">
                @foreach (var img in Model)
                {
                    photoIndex++;
                    var altText = Localizer["CTGallery"].Value + " " + photoIndex;
                    var rot = rotations[(photoIndex - 1) % rotations.Length];
                    var tape = tapes[(photoIndex - 1) % tapes.Length];

                    <div class="tn-snap" data-reveal>
                        <figure class="tn-polaroid" style="--rot:@rot;--tape:@tape">
                            <a href="@img" class="tn-polaroid__link" data-tn-photo>
                                <img src="@img" alt="@altText" loading="lazy" />
                            </a>
                            <figcaption class="tn-polaroid__cap">
                                <span>#@photoIndex.ToString("00")</span>
                                <i class="bi bi-heart-fill" aria-hidden="true"></i>
                            </figcaption>

                            @if (isAdmin)
                            {
                                var fileName = System.IO.Path.GetFileName(img);

                                <form asp-controller="Gallery"
                                      asp-action="DeletePicture"
                                      method="post"
                                      class="tn-polaroid__del"
                                      data-tn-delete>
                                    <input type="hidden" name="id" value="@tournamentId" />
                                    <input type="hidden" name="fileName" value="@fileName" />

                                    <button type="submit" class="btn btn-danger" title="@Localizer["TGDelete"]">
                                        <i class="bi bi-trash-fill" aria-hidden="true"></i>
                                        <span class="visually-hidden">@Localizer["TGDelete"] - @altText</span>
                                    </button>
                                </form>
                            }
                        </figure>
                    </div>
                }
            </div>
        </div>

        @if (!isAdmin)
        {
            <p class="tn-gal-note">
                <i class="bi bi-info-circle" aria-hidden="true"></i>@Localizer["TGOnlyAdmins"]
            </p>

            @* Anybody who is in a picture can have it taken down (GDPR): by message, or by e-mail without an account. *@
            <p class="tn-gal-note">
                <i class="bi bi-shield-check" aria-hidden="true"></i>
                <span>
                    @Localizer["TGRemovalNote"]
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="ContactMessage" asp-action="Create">@Localizer["TGRemovalWrite"]</a>
                    }
                    else if (!string.IsNullOrWhiteSpace(SiteOptions.Value.ContactEmail))
                    {
                        <a href="mailto:@SiteOptions.Value.ContactEmail">@SiteOptions.Value.ContactEmail</a>
                    }
                    else
                    {
                        <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Create", "ContactMessage")">@Localizer["TGRemovalWrite"]</a>
                    }
                </span>
            </p>
        }
    }

</section>

@section Scripts {
    <script>
        (function () {
            var grid = document.querySelector('[data-tn-gallery]');
            if (!grid) { return; }

            var links = Array.prototype.slice.call(grid.querySelectorAll('[data-tn-photo]'));
            var current = 0;
            var box = null, image = null, counter = null, lastFocus = null;

            function button(cls, label, icon, onClick) {
                var b = document.createElement('button');
                b.type = 'button';
                b.className = 'tn-lb__btn ' + cls;
                b.setAttribute('aria-label', label);
                var i = document.createElement('i');
                i.className = 'bi ' + icon;
                i.setAttribute('aria-hidden', 'true');
                b.appendChild(i);
                b.addEventListener('click', function (ev) { ev.stopPropagation(); onClick(); });
                return b;
            }

            function build() {
                box = document.createElement('div');
                box.className = 'tn-lb';
                box.setAttribute('role', 'dialog');
                box.setAttribute('aria-modal', 'true');

                image = document.createElement('img');
                image.className = 'tn-lb__img';
                image.alt = '';

                counter = document.createElement('div');
                counter.className = 'tn-lb__count';

                box.appendChild(image);
                box.appendChild(counter);
                box.appendChild(button('tn-lb__close', grid.getAttribute('data-label-close'), 'bi-x-lg', close));
                box.appendChild(button('tn-lb__prev', grid.getAttribute('data-label-prev'), 'bi-chevron-left', function () { step(-1); }));
                box.appendChild(button('tn-lb__next', grid.getAttribute('data-label-next'), 'bi-chevron-right', function () { step(1); }));

                box.addEventListener('click', function (ev) {
                    if (ev.target !== image) { close(); }
                });
                document.body.appendChild(box);
            }

            function show(index) {
                current = (index + links.length) % links.length;
                var thumb = links[current].querySelector('img');
                image.src = links[current].getAttribute('href');
                image.alt = thumb ? thumb.alt : '';
                counter.textContent = (current + 1) + ' / ' + links.length;
            }

            function open(index) {
                if (!box) { build(); }
                lastFocus = document.activeElement;
                show(index);
                box.classList.add('is-open');
                document.body.style.overflow = 'hidden';
                box.querySelector('.tn-lb__close').focus();
            }

            function close() {
                if (!box) { return; }
                box.classList.remove('is-open');
                document.body.style.overflow = '';
                if (lastFocus && lastFocus.focus) { lastFocus.focus(); }
            }

            function step(delta) { show(current + delta); }

            links.forEach(function (link, index) {
                link.addEventListener('click', function (ev) {
                    if (ev.ctrlKey || ev.metaKey || ev.shiftKey) { return; }
                    ev.preventDefault();
                    open(index);
                });
            });

            document.addEventListener('keydown', function (ev) {
                if (!box || !box.classList.contains('is-open')) { return; }
                if (ev.key === 'Escape') { close(); }
                else if (ev.key === 'ArrowLeft') { step(-1); }
                else if (ev.key === 'ArrowRight') { step(1); }
            });

            // Confirm before deleting a picture.
            grid.addEventListener('submit', function (ev) {
                var form = ev.target;
                if (form && form.hasAttribute && form.hasAttribute('data-tn-delete')) {
                    if (!window.confirm(grid.getAttribute('data-label-confirm'))) {
                        ev.preventDefault();
                    }
                }
            });
        })();
    </script>
}
