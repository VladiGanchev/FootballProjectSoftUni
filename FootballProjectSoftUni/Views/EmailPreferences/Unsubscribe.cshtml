@model UnsubscribeViewModel
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["UnsubTitle"].Value;
}

<div class="tg-form-wrap">
    <div class="tg-form-card tg-form-card--sm">
        <div class="tg-form-card__head">
            <span class="tg-icon-tile" aria-hidden="true"><i class="bi bi-envelope-paper-fill"></i></span>
            <h1 class="tg-form-card__title">@Localizer["UnsubTitle"]</h1>
        </div>

        @if (Model.Done)
        {
            <div class="alert alert-success" role="status">
                <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@Localizer["UnsubDone"]
            </div>
            <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-dark w-100">@Localizer["UnsubToProfile"]</a>
        }
        else if (Model.Valid)
        {
            <p class="tg-form-card__sub mb-4">@Localizer["UnsubQuestion"]</p>

            <form asp-action="Unsubscribe" method="post">
                <input type="hidden" name="u" value="@Model.U" />
                <input type="hidden" name="k" value="@Model.K" />
                <button type="submit" class="btn btn-accent btn-lg w-100">
                    <i class="bi bi-envelope-x-fill" aria-hidden="true"></i>@Localizer["UnsubButton"]
                </button>
            </form>
        }
        else
        {
            <div class="alert alert-warning" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@Localizer["UnsubInvalid"]
            </div>
            <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-dark w-100">@Localizer["UnsubToProfile"]</a>
        }
    </div>
</div>
