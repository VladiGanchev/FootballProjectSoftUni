@using System.Security.Claims;
@using FootballProjectSoftUni.Infrastructure.Data.Enums;
@using FootballProjectSoftUni.Core.Models.Tournament;
@model IEnumerable<TournamentViewModel>
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer


@{
    ViewData["Title"] = Localizer["DParticipate"].Value;

    // Same status rules as before: Upcoming / Started / Finished
    string State(TournamentViewModel t)
    {
        if (t.StartDate > BgTime.Now)
        {
            return nameof(TournamentStatus.Upcoming);
        }

        if (BgTime.Now > t.StartDate && BgTime.Now < t.EndDate)
        {
            return nameof(TournamentStatus.Started);
        }

        return nameof(TournamentStatus.Finished);
    }

    var list = Model != null ? Model.OrderBy(t => t.StartDate).ToList() : new List<TournamentViewModel>();
    var upcomingCount = list.Count(t => State(t) == nameof(TournamentStatus.Upcoming));
    var liveCount = list.Count(t => State(t) == nameof(TournamentStatus.Started));
}

<header class="tp-fx-head">
    <div>
        <h1 class="tp-giant" data-split>@Localizer["DParticipate"]</h1>
    </div>

    @if (list.Any())
    {
        <dl class="tp-scoreboard">
            <div>
                <dt>@Localizer["TNTitle"]</dt>
                <dd data-count="@list.Count">@list.Count</dd>
            </div>
            <div>
                <dt>@Localizer["TNStatusUpcoming"]</dt>
                <dd>@upcomingCount</dd>
            </div>
            <div class="is-live">
                <dt>@Localizer["TNStatusStarted"]</dt>
                <dd>@liveCount</dd>
            </div>
        </dl>
    }
</header>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@TempData["ErrorMessage"]
    </div>
}

@if (Model == null || !Model.Any())
{
    <div class="tg-empty">
        <span class="tg-empty__icon" aria-hidden="true"><i class="bi bi-calendar-x"></i></span>
        <h5>@Localizer["ATNoRefereeTournaments"]</h5>
        <p class="text-muted mb-0">
            @Localizer["ATWhen"]
        </p>
    </div>
}
else
{
    @* ============ DATE STRIP ============ *@
    <nav class="tp-strip" aria-label="@Localizer["TNTitle"]">
        <div class="tp-strip__track" data-drag-scroll>
            @{ var todayPlaced = false; }
            @foreach (var e in list)
            {
                if (!todayPlaced && e.StartDate.Date >= BgTime.Today)
                {
                    todayPlaced = true;
                    <span class="tp-day tp-day--today" aria-hidden="true">
                        <span class="tp-day__dow">@BgTime.Today.ToString("ddd")</span>
                        <b class="tp-day__num">@BgTime.Today.ToString("dd")</b>
                        <span class="tp-day__mon">@BgTime.Today.ToString("MMM")</span>
                        <span class="tp-day__tag">@Localizer["TpToday"]</span>
                    </span>
                }

                var st = State(e);
                var dayClass = st == nameof(TournamentStatus.Started) ? "tp-day--live" : st == nameof(TournamentStatus.Finished) ? "tp-day--past" : string.Empty;

                <a class="tp-day @dayClass" href="#fx-@e.Id">
                    <span class="tp-day__dow">@e.StartDate.ToString("ddd")</span>
                    <b class="tp-day__num">@e.StartDate.ToString("dd")</b>
                    <span class="tp-day__mon">@e.StartDate.ToString("MMM")</span>
                    <span class="tp-day__tag">@e.CityName</span>
                </a>
            }
            @if (!todayPlaced)
            {
                <span class="tp-day tp-day--today" aria-hidden="true">
                    <span class="tp-day__dow">@BgTime.Today.ToString("ddd")</span>
                    <b class="tp-day__num">@BgTime.Today.ToString("dd")</b>
                    <span class="tp-day__mon">@BgTime.Today.ToString("MMM")</span>
                    <span class="tp-day__tag">@Localizer["TpToday"]</span>
                </span>
            }
        </div>
    </nav>

    @* ============ TICKETS ============ *@
    <ol class="tp-fx-list">
        @foreach (var e in list)
        {
            var st = State(e);
            string statusText;
            string statusClass;
            string fxClass;

            if (st == nameof(TournamentStatus.Upcoming))
            {
                statusText = Localizer["TNStatusUpcoming"].Value;
                statusClass = "tg-chip--sky";
                fxClass = "tp-fx--upcoming";
            }
            else if (st == nameof(TournamentStatus.Started))
            {
                statusText = Localizer["TNStatusStarted"].Value;
                statusClass = "tg-chip--green tg-chip--live";
                fxClass = "tp-fx--live";
            }
            else
            {
                statusText = Localizer["TNStatusFinished"].Value;
                statusClass = "";
                fxClass = "tp-fx--past";
            }

            var fillPct = Math.Min(100, (int)Math.Round(e.NumberOfTeams * 100.0 / 16));

            <li class="tg-ticket tp-fx @fxClass" id="fx-@e.Id">

                <div class="tp-fx__main">
                    <div class="tp-fx__date" aria-hidden="true">
                        <span>@e.StartDate.ToString("ddd")</span>
                        <b>@e.StartDate.ToString("dd")</b>
                        <span>@e.StartDate.ToString("MMM")</span>
                    </div>

                    <div class="tp-fx__img">
                        <img src="@CoverPictureStore.Small(e.ImageUrl)" data-full="@e.ImageUrl" alt="@e.CityName" loading="lazy" />
                    </div>

                    <div class="tp-fx__info">
                        <span class="tg-chip @statusClass">@statusText</span>
                        <h2 class="tp-fx__city">@e.CityName</h2>
                        <div class="tp-fx__times">
                            <span><i class="bi bi-calendar-event" aria-hidden="true"></i>@Localizer["ATCStart"] <b>@e.StartDate.ToString("dd.MM.yyyy HH:mm")</b></span>
                            <span><i class="bi bi-calendar-check" aria-hidden="true"></i>@Localizer["ATCEnd"] <b>@e.EndDate.ToString("dd.MM.yyyy HH:mm")</b></span>
                        </div>
                        <div class="tp-fx__teams">
                            <span>@Localizer["ATCTeams"]</span>
                            <div class="tg-progress" role="progressbar" aria-label="@Localizer["ATCTeams"]" aria-valuemin="0" aria-valuemax="16" aria-valuenow="@e.NumberOfTeams">
                                <span style="width:@fillPct%"></span>
                            </div>
                            <b>@e.NumberOfTeams / 16</b>
                        </div>
                    </div>

                    @if (st == nameof(TournamentStatus.Finished))
                    {
                        <span class="tp-fx__used" aria-hidden="true">@Localizer["TNStatusFinished"]</span>
                    }
                </div>

                <div class="tg-ticket__stub tp-fx__stub">
                    <span class="tp-fx__role"><i class="bi bi-flag-fill" aria-hidden="true"></i>@Localizer["DAsReferee"]</span>

                    <a asp-controller="Tournament"
                       asp-action="Details"
                       asp-route-id="@e.Id"
                       asp-route-information="@e.Information"
                       class="btn btn-primary btn-sm">
                        <i class="bi bi-info-circle" aria-hidden="true"></i>
                        @Localizer["CTDetails"]
                    </a>

                    @* A referee can step back only before the start: nobody can replace him afterwards. *@
                    @if (BgTime.Now < e.StartDate)
                    {
                        <form asp-controller="Referee" asp-action="LeaveTournament" asp-route-id="@e.Id" method="post"
                              class="tn-inline-form" data-confirm="@Localizer["RefereeLeaveConfirm"]">
                            <button type="submit" class="btn btn-outline-dark btn-sm">
                                <i class="bi bi-box-arrow-left" aria-hidden="true"></i>
                                @Localizer["ATLeave"]
                            </button>
                        </form>
                    }

                    <span class="tp-fx__code" aria-hidden="true">No. @e.Id.ToString("D4")</span>
                </div>

            </li>
        }
    </ol>
}
