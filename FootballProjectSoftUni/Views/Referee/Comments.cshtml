@using FootballProjectSoftUni.Extensions
@model FootballProjectSoftUni.Core.Models.Referee.RefereeCommentsPageViewModel
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer


@{
    ViewData["Title"] = $"{Localizer["CComments"].Value} {Model.RefereeName}";

    string Initials(string name)
    {
        if (string.IsNullOrWhiteSpace(name))
        {
            return "?";
        }

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        var first = parts[0].Substring(0, 1);
        var last = parts.Length > 1 ? parts[parts.Length - 1].Substring(0, 1) : string.Empty;
        return (first + last).ToUpperInvariant();
    }

    // Stable avatar colour per author
    string Tone(string name)
    {
        var tones = new[] { "sun", "mint", "lilac", "coral", "sky" };
        int h = 0;
        foreach (var ch in name ?? string.Empty)
        {
            h = (h * 31 + ch) & 0x7fffffff;
        }
        return tones[h % tones.Length];
    }

    var hasComments = Model.Comments != null && Model.Comments.Any();

    // Oldest first, like a chat; the newest message sits next to the composer
    var thread = hasComments
        ? Model.Comments!.OrderBy(c => c.CreatedOn).ToList()
        : new List<FootballProjectSoftUni.Core.Models.Referee.RefereeCommentViewModel>();

    // The visitor's own comments sit on the right.
    var me = User.Id();

    var lastDate = hasComments ? BgTime.FromUtc(thread[thread.Count - 1].CreatedOn).ToString("dd.MM") : "–";
}

<div class="tp-chatpage">

    @* ============ SIDE: mini FUT card of the referee ============ *@
    <aside class="tp-chatside">
        <a asp-action="Referees" class="btn btn-outline-dark btn-sm">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>@Localizer["CBackToReferees"]
        </a>

        <div class="tp-fut tp-fut--ink tp-fut--mini" data-tilt="14" aria-hidden="true">
            <div class="tp-fut__rate">
                <span class="tp-fut__num">@thread.Count</span>
                <span class="tp-fut__pos">@Localizer["TpPosRef"]</span>
                <span class="tp-fut__crest"><i class="bi bi-chat-dots-fill"></i></span>
            </div>
            <div class="tp-fut__medal"><span>@Initials(Model.RefereeName)</span></div>
            <div class="tp-fut__name">@Model.RefereeName</div>
            <ul class="tp-fut__stats" style="--cols:2">
                <li class="tp-fut__stat"><b>@thread.Count</b><small>@Localizer["RComments"]</small></li>
                <li class="tp-fut__stat"><b>@lastDate</b><small>@Localizer["IDate"]</small></li>
            </ul>
        </div>

        <p class="tp-chatside__note">@Localizer["CSeeComments"]</p>
    </aside>

    @* ============ CHAT WINDOW ============ *@
    <section class="tp-chat" aria-labelledby="tp-chat-title">
        <header class="tp-chat__head">
            <span class="tg-avatar-lg" aria-hidden="true">@Initials(Model.RefereeName)</span>
            <div>
                <h1 class="tp-chat__title" id="tp-chat-title">@Localizer["CComments"] <em>@Model.RefereeName</em></h1>
                <div class="tp-chat__meta">
                    <span class="tg-chip tg-chip--sun"><i class="bi bi-chat-dots-fill" aria-hidden="true"></i>@thread.Count @Localizer["RComments"]</span>
                </div>
            </div>
        </header>

        <div class="tp-chat__body" id="tp-chat-body" tabindex="0" aria-label="@Localizer["RComments"]">
            @if (hasComments)
            {
                DateTime? day = null;

                <ul class="tp-thread">
                    @foreach (var c in thread)
                    {
                        // Comments are saved in UTC; shown (and grouped by day) in Bulgarian time.
                        var at = BgTime.FromUtc(c.CreatedOn);

                        if (day != at.Date)
                        {
                            day = at.Date;
                            var dayText = day == BgTime.Today ? Localizer["TpToday"].Value : at.ToString("dd MMMM yyyy");
                            <li class="tp-dayline" aria-hidden="true"><span>@dayText</span></li>
                        }

                        var mine = !string.IsNullOrEmpty(me) && c.UserId == me;

                        <li class="tp-msg @(mine ? "tp-msg--me" : "")">
                            <span class="tg-avatar tp-tone-@Tone(c.UserName)" aria-hidden="true">@Initials(c.UserName)</span>

                            <div class="tp-msg__bubble">
                                <span class="tp-msg__name">@c.UserName</span>
                                <p class="tp-msg__text">@c.Content</p>
                                <span class="tp-msg__time">
                                    <i class="bi bi-clock" aria-hidden="true"></i>
                                    <time datetime="@at.ToString("yyyy-MM-ddTHH:mm")">@at.ToString("dd.MM.yyyy HH:mm")</time>
                                </span>

                                @* The organisers remove a comment that breaks the rules; anybody else can report it. *@
                                @if (User.IsAdmin())
                                {
                                    <form asp-action="DeleteComment" asp-route-id="@c.Id" method="post"
                                          class="tp-msg__action" data-confirm="@Localizer["CRDeleteConfirm"]">
                                        <button type="submit" class="tp-msg__link tp-msg__link--danger">
                                            <i class="bi bi-trash3" aria-hidden="true"></i>@Localizer["CRDelete"]
                                        </button>
                                    </form>
                                }
                                else if (!mine)
                                {
                                    <a asp-action="ReportComment" asp-route-id="@c.Id" class="tp-msg__action tp-msg__link">
                                        <i class="bi bi-flag" aria-hidden="true"></i>@Localizer["CRReport"]
                                    </a>
                                }
                            </div>
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="tg-empty">
                    <span class="tg-empty__icon" aria-hidden="true"><i class="bi bi-chat-left-text"></i></span>
                    <h5>@Localizer["CNotYet"]</h5>
                    <p class="text-muted mb-0">@Localizer["CBeFirst"]</p>
                </div>
            }
        </div>

        @* Sticky composer *@
        <div class="tp-composer-wrap">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2" aria-hidden="true"></i>@TempData["Error"]
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success" role="status">
                    <i class="bi bi-check-circle-fill me-2" aria-hidden="true"></i>@TempData["Success"]
                </div>
            }

            @* A referee does not comment on himself. *@
            @if (Model.RefereeId != User.Id())
            {
                <form asp-action="AddComment" method="post" class="tp-composer" id="tp-composer">
                    <input type="hidden" name="refereeId" value="@Model.RefereeId" />

                    <label for="tp-comment-content" class="visually-hidden">@Localizer["CAdd"]</label>
                    <textarea id="tp-comment-content"
                              name="content"
                              class="form-control"
                              rows="1"
                              placeholder="@Localizer["CAdd"]"
                              required></textarea>

                    <button type="submit" class="btn btn-accent">
                        <i class="bi bi-send-fill" aria-hidden="true"></i>
                        <span class="tp-send__txt">@Localizer["CPublish"]</span>
                    </button>
                </form>
            }
        </div>
    </section>

</div>

@section Scripts {
    <script>
        (function () {
            var body = document.getElementById("tp-chat-body");
            if (body) { body.scrollTop = body.scrollHeight; }

            var form = document.getElementById("tp-composer");
            var area = document.getElementById("tp-comment-content");
            if (!form || !area) { return; }

            function grow() {
                area.style.height = "auto";
                area.style.height = Math.min(area.scrollHeight, 180) + "px";
            }

            area.addEventListener("input", grow);
            area.addEventListener("keydown", function (e) {
                if (e.key === "Enter" && (e.ctrlKey || e.metaKey)) {
                    e.preventDefault();
                    var btn = form.querySelector("button[type=submit]");
                    if (btn) { btn.click(); }
                }
            });
        })();
    </script>
}
