@using FootballProjectSoftUni.Core.Models.City
@model CityViewModel
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer

@{
    ViewBag.Title = "Create a New City";
    ViewData["FullWidth"] = true;
}

<div class="container-xl cp-page">
    <header class="cp-studio__head">
        <h1 class="cp-mega cp-mega--md" data-split>@Localizer["DAddCity"]</h1>
        <p class="cp-lead">@Localizer["CPAddCitySub"]</p>
    </header>

    <partial name="_CityFormPartial" model="Model" />
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/picture-picker.js" asp-append-version="true"></script>

    <script>
        (function () {
            var name = document.getElementById('Name');
            var picker = document.querySelector('[data-picture-picker]');
            var box = document.getElementById('cityPreview');
            var img = document.getElementById('cityPreviewImg');
            var title = document.getElementById('cityPreviewName');
            if (!name || !picker || !box || !img || !title) { return; }

            var fallbackName = title.getAttribute('data-default');

            function showName() {
                title.textContent = name.value.trim() || fallbackName;
            }

            // "Develop" the instant photo each time a new image arrives
            img.addEventListener('load', function () {
                box.classList.remove('is-loaded');
                void box.offsetWidth;
                box.classList.add('is-loaded');
            });
            img.addEventListener('error', function () { box.classList.remove('is-loaded'); });

            picker.addEventListener('picture:chosen', function (e) { img.src = e.detail.url; });
            picker.addEventListener('picture:cleared', function () {
                img.removeAttribute('src');
                box.classList.remove('is-loaded');
            });

            name.addEventListener('input', showName);
            showName();
        })();
    </script>
}
