@using FootballProjectSoftUni.Extensions
@using FootballProjectSoftUni.Core.Models.Partner
@model IEnumerable<FootballProjectSoftUni.Core.Models.Partner.PartnerViewModel>
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["DPartners"].Value;
    ViewData["FullWidth"] = true;

    var partners = Model?.ToList() ?? new List<PartnerViewModel>();
    // repeat logos so each tape is long enough for a seamless loop
    var rotations = new[] { "-2deg", "1.5deg", "-1deg", "2.5deg", "-2.5deg", "1deg", "0deg" };

    string Initial(string name) => string.IsNullOrWhiteSpace(name) ? "?" : name.Trim()[0].ToString().ToUpperInvariant();
}

<div class="container-xl cp-page pb-0">

    @if (TempData["PaymentMessage"] != null)
    {
        var type = TempData["PaymentType"]?.ToString() ?? "info";
        <div class="cp-alerts">
            <div class="alert alert-@type mb-0" role="alert">
                <i class="bi bi-info-circle-fill me-2" aria-hidden="true"></i>
                @TempData["PaymentMessage"]
            </div>
        </div>
    }

    <section class="cp-hero" aria-labelledby="partnersTitle">
        <div class="cp-hero__top">

            @if (User.IsAdmin())
            {
                <div class="cp-admin">
                    <a asp-controller="Partner" asp-action="AddPartner" class="btn btn-accent btn-sm">
                        <i class="bi bi-plus-lg" aria-hidden="true"></i>@Localizer["DAddPartner"]
                    </a>
                    <a asp-controller="Partner" asp-action="DeletePartner" class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-person-x-fill" aria-hidden="true"></i>@Localizer["DDeletePartner"]
                    </a>
                    <a asp-controller="Partner" asp-action="ChangePicture" class="btn btn-outline-dark btn-sm">
                        <i class="bi bi-image-fill" aria-hidden="true"></i>@Localizer["PicChangeLogoShort"]
                    </a>
                </div>
            }
        </div>

        <h1 class="cp-mega cp-mega--partners" id="partnersTitle" data-split>
            @Localizer["DPartners"]
            @if (partners.Any())
            {
                <sup class="cp-mega__sup">@partners.Count</sup>
            }
        </h1>

        <p class="cp-lead">@Localizer["CPPartnersLead"]</p>
    </section>
</div>

@if (partners.Any())
{
    @* ============ Interactive sticker wall ============ *@
    <div class="container-xl">
        <section aria-labelledby="wallTitle">
            <div class="cp-wall-head">
                <h2 class="cp-wall-title" id="wallTitle">@Localizer["CPPartnersWall"]</h2>
                <span class="tg-sticker tg-sticker--mint" style="--rot:3deg">
                    <i class="bi bi-people-fill" aria-hidden="true"></i>@partners.Count
                </span>
            </div>

            <ul class="cp-wall">
                @for (int i = 0; i < partners.Count; i++)
                {
                    var partner = partners[i];
                    var tileClass = "cp-tile"
                        + (i % 7 == 0 ? " cp-tile--xl" : (i % 7 == 4 ? " cp-tile--wide" : ""))
                        + (i % 5 == 2 ? " cp-tile--mint" : (i % 5 == 4 ? " cp-tile--lilac" : ""));
                    var tileStyle = "--rot:" + rotations[i % rotations.Length] + ";--i:" + i;

                    <li class="@tileClass" style="@tileStyle" data-tilt="14" data-spotlight>
                        <span class="cp-tile__no" aria-hidden="true">@((i + 1).ToString("00"))</span>

                        <div class="cp-tile__logo">
                            <img src="@CoverPictureStore.Small(partner.ImageUrl)" data-full="@partner.ImageUrl"
                                 alt=""
                                 loading="lazy"
                                 data-broken-parent />
                            <span class="cp-tile__initial" aria-hidden="true">@Initial(partner.Name)</span>
                        </div>

                        <h3 class="cp-tile__name">@partner.Name</h3>
                    </li>
                }
            </ul>
        </section>
    </div>
}
else
{
    <div class="container-xl">
        <div class="tg-empty cp-empty">
            <span class="tg-empty__icon"><i class="bi bi-people" aria-hidden="true"></i></span>
            <h5>@Localizer["AllNoPartners"]</h5>
            <p class="text-muted mb-0">@Localizer["AllPartnersWillShow"]</p>
        </div>
    </div>
}
