@using FootballProjectSoftUni.Core.Models.Partner
@model PartnerViewModel
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["DPDeletePartner"].Value;
    ViewData["FullWidth"] = true;
}

<div class="container-xl cp-page">
    <div class="cp-rc">

        <div class="cp-rc__stage">
            <span class="cp-card cp-card--yellow" aria-hidden="true"></span>

            <div class="cp-card cp-card--red">
                <div class="cp-card__top" aria-hidden="true">
                    <i class="bi bi-x-octagon-fill"></i>
                </div>

                <div class="cp-card__subject">
                    <span class="cp-card__thumb cp-card__thumb--logo">
                        <i class="bi bi-image" aria-hidden="true"></i>
                        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
                        {
                            <img src="@Model.ImageUrl" alt="@Model.Name" data-hide-on-error />
                        }
                    </span>
                    <span class="cp-card__eyebrow">@Localizer["DCDP"]</span>
                    <p class="cp-card__name">@Model.Name</p>
                </div>

                <div class="cp-card__foot" aria-hidden="true">@Localizer["CPRedCard"]</div>
            </div>
        </div>

        <div class="tg-form-card cp-rc__panel">
            <div class="tg-form-card__head">
                <h1 class="tg-form-card__title">@Localizer["DCDP"]</h1>
                <p class="tg-form-card__sub">@Localizer["DCConfirm"]</p>
            </div>

            <div class="cp-warn" role="alert">
                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                <div>@Localizer["DCAreYousure"]</div>
            </div>

            <form asp-action="DeleteConfirmed" method="post">
                <input type="hidden" asp-for="Id" />

                <div class="tg-form-actions">
                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="bi bi-trash3-fill" aria-hidden="true"></i>@Localizer["DCCD"]
                    </button>

                    <a asp-action="All" class="btn btn-outline-dark btn-lg">
                        <i class="bi bi-x-lg" aria-hidden="true"></i>@Localizer["DCCancel"]
                    </a>
                </div>
            </form>
        </div>

    </div>
</div>
