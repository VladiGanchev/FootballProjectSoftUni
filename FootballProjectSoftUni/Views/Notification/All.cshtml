@using FootballProjectSoftUni.Core.Models.ContactMessage
@using FootballProjectSoftUni.Core.Models.Notification
@using X.PagedList
@model NotificationAllPageViewModel
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["NotifPageTitle"].Value;

    var isSent = Model.Box == "sent";
    var boxName = isSent ? "sent" : "inbox";

    var hasItems = isSent
        ? (Model.SentMessages != null && Model.SentMessages.Any())
        : (Model.Notifications != null && Model.Notifications.Any());

    var pageNumber = isSent ? (Model.SentMessages?.PageNumber ?? 1) : (Model.Notifications?.PageNumber ?? 1);
    var pageCount = isSent ? (Model.SentMessages?.PageCount ?? 1) : (Model.Notifications?.PageCount ?? 1);
    var hasPrev = isSent ? (Model.SentMessages?.HasPreviousPage ?? false) : (Model.Notifications?.HasPreviousPage ?? false);
    var hasNext = isSent ? (Model.SentMessages?.HasNextPage ?? false) : (Model.Notifications?.HasNextPage ?? false);
    var previousPage = pageNumber - 1;
    var nextPage = pageNumber + 1;

    // UI only: folder total + avatar helpers
    var totalItems = isSent ? (Model.SentMessages?.TotalItemCount ?? 0) : (Model.Notifications?.TotalItemCount ?? 0);

    string Initials(string? name) => string.IsNullOrWhiteSpace(name)
        ? "TG"
        : string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => char.ToUpperInvariant(p[0])));

    var tones = new[] { "sun", "mint", "lilac", "sky", "coral" };
    string Tone(string? name) => tones[(name ?? string.Empty).Sum(c => (int)c) % tones.Length];

    string IsoUtc(DateTime d) => DateTime.SpecifyKind(d, DateTimeKind.Utc).ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", System.Globalization.CultureInfo.InvariantCulture);
}

<section class="msg-app">

    @* ===== Sidebar: title, compose, folders ===== *@
    <aside class="msg-side tg-card tg-card--pop">
        <div class="msg-side__head">
            <h1 class="msg-side__title">@Localizer["NotifPageTitle"]</h1>
        </div>

        <a asp-controller="ContactMessage" asp-action="Create" class="btn btn-accent btn-lg msg-compose" data-magnetic=".12">
            <i class="bi bi-pencil-square" aria-hidden="true"></i>@Localizer["MsgCompose"]
        </a>

        <nav class="msg-folders" aria-label="@Localizer["AllIncoming"] / @Localizer["AllSent"]">
            <a asp-controller="Notification"
               asp-action="All"
               asp-route-box="inbox"
               class="msg-folder @(isSent ? "" : "is-active")"
               aria-current="@(isSent ? null : "page")">
                <span class="msg-folder__ico" aria-hidden="true"><i class="bi bi-inbox-fill"></i></span>
                <span class="msg-folder__label">@Localizer["AllIncoming"]</span>
                @if (!isSent && totalItems > 0)
                {
                    <span class="msg-folder__count">@totalItems</span>
                }
                else if (isSent)
                {
                    <i class="bi bi-chevron-right msg-folder__go" aria-hidden="true"></i>
                }
            </a>

            <a asp-controller="Notification"
               asp-action="All"
               asp-route-box="sent"
               class="msg-folder @(isSent ? "is-active" : "")"
               aria-current="@(isSent ? "page" : null)">
                <span class="msg-folder__ico" aria-hidden="true"><i class="bi bi-send-fill"></i></span>
                <span class="msg-folder__label">@Localizer["AllSent"]</span>
                @if (isSent && totalItems > 0)
                {
                    <span class="msg-folder__count">@totalItems</span>
                }
                else if (!isSent)
                {
                    <i class="bi bi-chevron-right msg-folder__go" aria-hidden="true"></i>
                }
            </a>
        </nav>

        <div class="msg-side__pitch" aria-hidden="true">
            <span class="msg-side__goal"></span>
            <span class="msg-side__ball"></span>
        </div>
    </aside>

    @* ===== Feed ===== *@
    <div class="msg-feed tg-card tg-card--pop">

        <header class="msg-feed__head">
            <span class="tg-icon-tile tg-icon-tile--sm @(isSent ? "tg-icon-tile--mint" : "tg-icon-tile--sky")" aria-hidden="true">
                <i class="bi @(isSent ? "bi-send-check-fill" : "bi-bell-fill")"></i>
            </span>
            <h2 class="msg-feed__title">@(isSent ? Localizer["AllSentMessages"] : Localizer["AllIncomingNotifications"])</h2>
            <div class="msg-feed__meta">
                @if (totalItems > 0)
                {
                    <span class="tg-chip tg-chip--ink"><i class="bi @(isSent ? "bi-send-fill" : "bi-inbox-fill")" aria-hidden="true"></i>@totalItems</span>
                }
                @if (pageCount > 1)
                {
                    <span class="tg-chip">@pageNumber / @pageCount</span>
                }
            </div>
        </header>

        @if (!hasItems)
        {
            <div class="msg-quiet" data-reveal>
                <partial name="~/Views/Notification/_QuietStadium.cshtml" />

                @if (isSent)
                {
                    <h3 class="msg-quiet__title">@Localizer["AllNoSent"]</h3>
                    <p class="msg-quiet__text">@Localizer["AllWhen"]</p>
                    <a asp-controller="ContactMessage" asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-pencil-square" aria-hidden="true"></i>@Localizer["MsgCompose"]
                    </a>
                }
                else
                {
                    <h3 class="msg-quiet__title">@Localizer["AllNoNotifications"]</h3>
                    <p class="msg-quiet__text">@Localizer["AllWhenYouHave"]</p>
                }
            </div>
        }
        else
        {
            <ul class="msg-list">
                @if (isSent)
                {
                    foreach (var msg in Model.SentMessages!)
                    {
                        var sentAva = "msg-ava msg-ava--" + Tone(msg.ToName);
                        var sentWhen = BgTime.FromUtc(msg.CreatedOn).ToString("g");

                        <li class="msg-row">
                            <span class="@sentAva" aria-hidden="true">
                                @Initials(msg.ToName)
                                <span class="msg-ava__badge msg-ava__badge--mint"><i class="bi bi-send-check-fill"></i></span>
                            </span>

                            <div class="msg-row__main">
                                <div class="msg-row__top">
                                    <span>@Localizer["AllSentTo"] <strong class="msg-row__from">@msg.ToName</strong></span>
                                </div>
                                <a asp-controller="ContactMessage"
                                   asp-action="OpenMessage"
                                   asp-route-messageId="@msg.Id"
                                   class="msg-row__title msg-row__link">@msg.Subject</a>
                                @if (!string.IsNullOrWhiteSpace(msg.Preview))
                                {
                                    <p class="msg-row__preview">@msg.Preview</p>
                                }
                            </div>

                            <div class="msg-row__side">
                                <time class="msg-time" datetime="@IsoUtc(msg.CreatedOn)" title="@sentWhen" data-msg-time>@sentWhen</time>
                                <i class="bi bi-chevron-right msg-row__chev" aria-hidden="true"></i>
                            </div>
                        </li>
                    }
                }
                else
                {
                    foreach (var notification in Model.Notifications!)
                    {
                        var hasMessage = notification.ContactMessageId != null;
                        var hasFrom = !string.IsNullOrWhiteSpace(notification.FromName);
                        var avaClass = hasMessage ? "msg-ava msg-ava--" + Tone(notification.FromName) : "msg-ava msg-ava--system";
                        var when = BgTime.FromUtc(notification.CreatedOn).ToString("g");

                        <li class="msg-row @(notification.IsRead ? "is-read" : "is-unread")">
                            <span class="@avaClass" aria-hidden="true">
                                @if (hasMessage && hasFrom)
                                {
                                    @Initials(notification.FromName)
                                }
                                else if (hasMessage)
                                {
                                    <i class="bi bi-envelope-fill"></i>
                                }
                                else
                                {
                                    <i class="bi bi-bell-fill"></i>
                                }

                                @if (hasMessage)
                                {
                                    <span class="msg-ava__badge msg-ava__badge--sky"><i class="bi bi-envelope-fill"></i></span>
                                }
                            </span>

                            <div class="msg-row__main">
                                <div class="msg-row__top">
                                    @if (hasMessage && hasFrom)
                                    {
                                        <span>@Localizer["AllReceivedFrom"] <strong class="msg-row__from">@notification.FromName</strong></span>
                                    }
                                    else
                                    {
                                        <span class="msg-row__from">Tournament Galaxy</span>
                                    }

                                    @if (!notification.IsRead)
                                    {
                                        <span class="msg-new"><span class="msg-dot" aria-hidden="true"></span>@Localizer["NotifNew"]</span>
                                    }
                                </div>

                                @if (hasMessage)
                                {
                                    <a asp-controller="ContactMessage"
                                       asp-action="OpenMessage"
                                       asp-route-messageId="@notification.ContactMessageId"
                                       class="msg-row__title msg-row__link">@notification.Message</a>
                                }
                                else
                                {
                                    <span class="msg-row__title msg-row__title--plain">@notification.Message</span>
                                }
                            </div>

                            <div class="msg-row__side">
                                <time class="msg-time" datetime="@IsoUtc(notification.CreatedOn)" title="@when" data-msg-time>@when</time>

                                <form asp-controller="Notification"
                                      asp-action="Delete"
                                      method="post"
                                      class="msg-del"
                                      data-confirm="@Localizer["NotifDeleteConfirm"]">
                                    <input type="hidden" name="id" value="@notification.Id" />
                                    <input type="hidden" name="box" value="@Model.Box" />
                                    <input type="hidden" name="page" value="@pageNumber" />
                                    <button type="submit"
                                            class="msg-del__btn"
                                            title="@Localizer["TGDelete"]"
                                            aria-label="@Localizer["TGDelete"]">
                                        <i class="bi bi-trash3" aria-hidden="true"></i>
                                    </button>
                                </form>
                            </div>
                        </li>
                    }
                }
            </ul>

            @if (pageCount > 1)
            {
                <nav class="msg-feed__foot" aria-label="Page navigation">
                    <ul class="pagination justify-content-center">
                        <li class="page-item @(hasPrev ? "" : "disabled")">
                            <a class="page-link"
                               href="@Url.Action("All", new { box = boxName, page = previousPage })"
                               aria-label="Previous"
                               tabindex="@(hasPrev ? 0 : -1)">
                                <i class="bi bi-chevron-left" aria-hidden="true"></i>
                            </a>
                        </li>

                        @for (int i = 1; i <= pageCount; i++)
                        {
                            <li class="page-item @(i == pageNumber ? "active" : "")">
                                <a class="page-link"
                                   href="@Url.Action("All", new { box = boxName, page = i })"
                                   aria-current="@(i == pageNumber ? "page" : null)">@i</a>
                            </li>
                        }

                        <li class="page-item @(hasNext ? "" : "disabled")">
                            <a class="page-link"
                               href="@Url.Action("All", new { box = boxName, page = nextPage })"
                               aria-label="Next"
                               tabindex="@(hasNext ? 0 : -1)">
                                <i class="bi bi-chevron-right" aria-hidden="true"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>

</section>

@section Scripts {
    <partial name="~/Views/Notification/_MsgTimeScript.cshtml" />
}
