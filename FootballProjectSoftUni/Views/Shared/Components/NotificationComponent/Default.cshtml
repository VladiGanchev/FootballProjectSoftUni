@model int
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer

<li class="nav-item msg-bell-item">
    <a class="nav-link tg-bell position-relative"
       asp-area=""
       asp-controller="Notification"
       asp-action="All"
       title="@Localizer["AllIncomingNotifications"]">

        <i class="bi bi-bell-fill" aria-hidden="true"></i>
        <span class="visually-hidden">@Localizer["AllIncomingNotifications"]</span>

        @if (Model > 0)
        {
            <span class="tg-bell-badge">
                @(Model > 99 ? "99+" : Model.ToString())
            </span>
        }
    </a>
</li>
