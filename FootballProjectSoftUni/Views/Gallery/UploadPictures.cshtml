@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer

@{
    ViewBag.Title = Localizer["UPUP"].Value;
}

<section class="tn-upload">

    <header class="tg-page-head tn-upload-head">
        <div>
            <h1 class="tg-page-head__title" data-split>@Localizer["UPUP"]</h1>
            <p class="tg-page-head__sub">@Localizer["UPOneOrMore"]</p>
        </div>
    </header>

    <form asp-action="UploadPictures" method="post" enctype="multipart/form-data">

        <div asp-validation-summary="ModelOnly" class="tn-vsum alert alert-danger" role="alert"></div>

        <input type="hidden" name="id" value="@ViewBag.TournamentId" />

        @* The whole pitch is the dropzone: the transparent file input covers it, so files can be dropped anywhere. *@
        <label class="tn-drop" for="tn-files" data-tn-drop>
            <svg class="tg-pitch-lines" viewBox="0 0 100 58" preserveAspectRatio="none" aria-hidden="true">
                <rect x="3" y="3" width="94" height="52" rx="1" />
                <line x1="50" y1="3" x2="50" y2="55" />
                <circle cx="50" cy="29" r="9" />
                <rect x="3" y="15" width="12" height="28" />
                <rect x="3" y="22" width="4.5" height="14" />
                <rect x="85" y="15" width="12" height="28" />
                <rect x="92.5" y="22" width="4.5" height="14" />
                <rect x="0.5" y="25" width="2.5" height="8" />
                <rect x="97" y="25" width="2.5" height="8" />
            </svg>

            <span class="tn-drop__ball" aria-hidden="true"><i class="bi bi-cloud-arrow-up-fill"></i></span>
            <span class="tn-drop__title">@Localizer["UPSelect"]</span>
            <span class="tn-drop__hint">@Localizer["TNDropHint"]</span>

            <input type="file"
                   id="tn-files"
                   name="files"
                   multiple
                   accept=".jpg,.jpeg,.png,.gif,.webp"
                   class="tn-drop__input" />
        </label>

        <div class="tn-previews" data-tn-previews data-text="@Localizer["TNSelectedCount", "{0}"]" hidden>
            <div class="tn-previews__count">
                <span class="tg-chip tg-chip--green" data-tn-count aria-live="polite"></span>
            </div>
            <div class="tn-previews__grid" data-tn-grid></div>
        </div>

        <div class="tn-upload__actions">
            <button type="submit" class="btn btn-accent btn-lg">
                <i class="bi bi-upload" aria-hidden="true"></i>@Localizer["UPUpload"]
            </button>

            <a asp-controller="Gallery"
               asp-action="TournamentGallery"
               asp-route-id="@ViewBag.TournamentId"
               class="btn btn-outline-dark btn-lg">
                @Localizer["DCCancel"]
            </a>
        </div>

    </form>

</section>

@section Scripts {
    <script>
        (function () {
            var drop = document.querySelector('[data-tn-drop]');
            var input = document.getElementById('tn-files');
            var previews = document.querySelector('[data-tn-previews]');
            if (!drop || !input || !previews) { return; }

            var grid = previews.querySelector('[data-tn-grid]');
            var count = previews.querySelector('[data-tn-count]');
            var template = previews.getAttribute('data-text') || '{0}';
            var urls = [];

            function clear() {
                urls.forEach(function (u) { URL.revokeObjectURL(u); });
                urls = [];
                while (grid.firstChild) { grid.removeChild(grid.firstChild); }
            }

            function render() {
                clear();
                var files = Array.prototype.slice.call(input.files || []);
                if (files.length === 0) {
                    previews.hidden = true;
                    return;
                }

                files.forEach(function (file) {
                    if (!file.type || file.type.indexOf('image/') !== 0) { return; }
                    var url = URL.createObjectURL(file);
                    urls.push(url);

                    var item = document.createElement('div');
                    item.className = 'tn-previews__item';
                    var img = document.createElement('img');
                    img.src = url;
                    img.alt = file.name;
                    img.loading = 'lazy';
                    item.appendChild(img);
                    grid.appendChild(item);
                });

                count.textContent = template.replace('{0}', files.length);
                previews.hidden = false;
            }

            input.addEventListener('change', render);

            ['dragenter', 'dragover'].forEach(function (name) {
                drop.addEventListener(name, function () { drop.classList.add('is-over'); });
            });
            ['dragleave', 'drop'].forEach(function (name) {
                drop.addEventListener(name, function () { drop.classList.remove('is-over'); });
            });
        })();
    </script>
}
