@using FootballProjectSoftUni.Extensions
@using Microsoft.AspNetCore.Identity
@using FootballProjectSoftUni.Infrastructure.Data.Models
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer
@inject SignInManager<ApplicationUser> SignInManager

@{
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;

    string Active(params string[] controllers) => controllers.Contains(controller) ? "is-active" : string.Empty;

    bool adminActive =
        controller == "Tournament"
        || controller == "Payments"
        || (controller == "City" && (action.Contains("Add") || action.Contains("Delete") || action.Contains("Update") || action.Contains("Change")))
        || (controller == "Partner" && (action.Contains("Add") || action.Contains("Delete") || action.Contains("Change")));
}

<ul class="navbar-nav tg-menu">
    <li class="tg-nav-indicator" aria-hidden="true"></li>
    <li class="nav-item">
        <a class="nav-link tg-navlink @(controller == "Home" && action == "Index" ? "is-active" : "")" asp-area="" asp-controller="Home" asp-action="Index">@Localizer["DHome"]</a>
    </li>

    <li class="nav-item">
        <a class="nav-link tg-navlink @(controller == "City" && !adminActive ? "is-active" : "")" asp-area="" asp-controller="City" asp-action="All">@Localizer["DCities"]</a>
    </li>

    <li class="nav-item">
        <a class="nav-link tg-navlink @(controller == "Partner" && !adminActive ? "is-active" : "")" asp-area="" asp-controller="Partner" asp-action="All">@Localizer["DPartners"]</a>
    </li>

    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link tg-navlink @(controller == "Referee" && action == "Referees" ? "is-active" : "")" asp-controller="Referee" asp-action="Referees">@Localizer["DReferees"]</a>
        </li>

        @if (User.IsAdmin())
        {
            <li class="nav-item dropdown">
                <a class="nav-link tg-navlink dropdown-toggle @(adminActive ? "is-active" : "")"
                   href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-shield-lock-fill"></i>@Localizer["DAdmin"]
                </a>

                <ul class="dropdown-menu tg-dropdown" aria-labelledby="adminDropdown">
                    <li>
                        <a class="dropdown-item tg-dd-item" asp-area="" asp-controller="Tournament" asp-action="AddTournamentToCity">
                            <i class="bi bi-trophy-fill me-2"></i> @Localizer["DAddTournament"]
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item tg-dd-item" asp-area="" asp-controller="City" asp-action="AddCity">
                            <i class="bi bi-plus-circle-fill me-2"></i> @Localizer["DAddCity"]
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item tg-dd-item" asp-area="" asp-controller="City" asp-action="DeleteCity">
                            <i class="bi bi-trash-fill me-2"></i>@Localizer["DDeleteCity"]
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item tg-dd-item" asp-area="" asp-controller="City" asp-action="ChangePicture">
                            <i class="bi bi-image-fill me-2"></i>@Localizer["CPChangeCityPicture"]
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item tg-dd-item" asp-area="" asp-controller="Partner" asp-action="AddPartner">
                            <i class="bi bi-person-plus-fill me-2"></i>@Localizer["DAddPartner"]
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item tg-dd-item" asp-area="" asp-controller="Partner" asp-action="DeletePartner">
                            <i class="bi bi-person-x-fill me-2"></i>@Localizer["DDeletePartner"]
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item tg-dd-item" asp-area="" asp-controller="Partner" asp-action="ChangePicture">
                            <i class="bi bi-image-fill me-2"></i>@Localizer["CPChangePartnerLogo"]
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item tg-dd-item" asp-area="" asp-controller="City" asp-action="UpdateCityLeaders">
                            <i class="bi bi-arrow-repeat me-2"></i>@Localizer["DUCL"]
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item tg-dd-item" asp-area="" asp-controller="Payments" asp-action="Index">
                            <i class="bi bi-cash-coin me-2"></i> @Localizer["DRefund"]
                        </a>
                    </li>
                </ul>
            </li>
        }
        else
        {
            <li class="nav-item dropdown">
                <a class="nav-link tg-navlink dropdown-toggle @Active("Coach")"
                   href="#" id="participateDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                    @Localizer["DParticipate"]
                </a>

                <ul class="dropdown-menu tg-dropdown" aria-labelledby="participateDropdown">
                    <li>
                        <a class="dropdown-item tg-dd-item" asp-area="" asp-controller="Referee" asp-action="AllTournamentsToReferee">
                            <i class="bi bi-flag me-2"></i> @Localizer["DAsReferee"]
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item tg-dd-item" asp-area="" asp-controller="Coach" asp-action="AllTournamentsToParticipateAsCoach">
                            <i class="bi bi-person-badge-fill me-2"></i> @Localizer["DAsCoach"]
                        </a>
                    </li>
                </ul>
            </li>
        }
    }
</ul>
