@using FootballProjectSoftUni.Core.Models.AdminPayments
@using FootballProjectSoftUni.Core.Extensions
@using X.PagedList.Mvc.Core
@model AdminPaymentsPage
@inject IStringLocalizer<FootballProjectSoftUni.SharedResource> Localizer

@{
    ViewData["Title"] = Localizer["PayTitle"].Value;

    var payments = Model.Payments;
    string? status = Model.Status;
    string? search = Model.Search;

    // The stored statuses stay in English (the code relies on them); people see them translated.
    string StatusLabel(string s) => s switch
    {
        "Paid" => Localizer["PayStatusPaid"].Value,
        "Refunded" => Localizer["PayStatusRefunded"].Value,
        "Pending" => Localizer["PayStatusPending"].Value,
        "Expired" => Localizer["PayStatusExpired"].Value,
        "RefundPending" => Localizer["PayStatusRefundPending"].Value,
        "RefundFailed" => Localizer["PayStatusRefundFailed"].Value,
        _ => s
    };

    string Pill(string? value) => value == status ? "is-active" : string.Empty;
    string? Current(string? value) => value == status ? "page" : null;
}

<section class="msg-pay">

    <header class="msg-pay__head">
        <div>
            <div><h1 class="msg-pay__title">@Localizer["PayTitle"]</h1></div>
            <p class="msg-pay__sub">@Localizer["PaySub"]</p>
        </div>
        <div class="msg-pay__tags">
            <span class="tg-chip tg-chip--live">@BgTime.Today.ToString("dd.MM.yyyy")</span>
            <span class="tg-sticker tg-sticker--mint" style="--rot:5deg"><i class="bi bi-shield-lock-fill" aria-hidden="true"></i>Stripe</span>
        </div>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success msg-alert" role="status">
            <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
            <div>@TempData["Success"]</div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger msg-alert" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <div>@TempData["Error"]</div>
        </div>
    }

    @if (Model.AllCount == 0)
    {
        <div class="tg-empty">
            <span class="tg-empty__icon" aria-hidden="true"><i class="bi bi-wallet2"></i></span>
            <h5>@Localizer["INoTransactions"]</h5>
            <p class="text-muted mb-0">@Localizer["IWhenUsers"]</p>
        </div>
    }
    else
    {
        @* ===== Bento: scoreboard + KPI tiles (totals of all payments) ===== *@
        <div class="msg-bento">
            <article class="msg-kpi msg-kpi--board tg-card tg-card--ink" data-spotlight>
                <span class="msg-kpi__label"><i class="bi bi-cash-coin me-1" aria-hidden="true"></i>@Localizer["PayTotalPaid"]</span>
                <div class="msg-money">@Model.PaidTotal.ToString("N2") <small>€</small></div>

                <div class="msg-split">
                    <div class="msg-split__head">
                        <span>@Localizer["IStatus"]</span>
                        <span><b>@Model.PaidCount</b> / @Model.AllCount</span>
                    </div>
                    <div class="msg-split__bar" aria-hidden="true">
                        @if (Model.PaidCount > 0)
                        {
                            <span class="msg-split__seg msg-c-paid" style="--n:@Model.PaidCount" title="@Localizer["PayStatusPaid"]: @Model.PaidCount"></span>
                        }
                        @if (Model.RefundedCount > 0)
                        {
                            <span class="msg-split__seg msg-c-refunded" style="--n:@Model.RefundedCount" title="@Localizer["PayStatusRefunded"]: @Model.RefundedCount"></span>
                        }
                        @if (Model.PendingCount > 0)
                        {
                            <span class="msg-split__seg msg-c-pending" style="--n:@Model.PendingCount" title="@Localizer["PayStatusPending"]: @Model.PendingCount"></span>
                        }
                        @if (Model.OtherCount > 0)
                        {
                            <span class="msg-split__seg msg-c-other" style="--n:@Model.OtherCount" title="@Localizer["PayStatusOther"]: @Model.OtherCount"></span>
                        }
                    </div>
                    <ul class="msg-split__legend">
                        <li><span class="msg-swatch msg-c-paid" aria-hidden="true"></span>@Localizer["PayStatusPaid"] <b>@Model.PaidCount</b></li>
                        <li><span class="msg-swatch msg-c-refunded" aria-hidden="true"></span>@Localizer["PayStatusRefunded"] <b>@Model.RefundedCount</b></li>
                        <li><span class="msg-swatch msg-c-pending" aria-hidden="true"></span>@Localizer["PayStatusPending"] <b>@Model.PendingCount</b></li>
                        @if (Model.OtherCount > 0)
                        {
                            <li><span class="msg-swatch msg-c-other" aria-hidden="true"></span>@Localizer["PayStatusOther"] <b>@Model.OtherCount</b></li>
                        }
                    </ul>
                </div>
            </article>

            <a class="msg-kpi msg-kpi--orders tg-card tg-card--sun" asp-action="Index" asp-fragment="msgPayDesk" data-tilt="6">
                <i class="bi bi-receipt msg-kpi__icon" aria-hidden="true"></i>
                <span class="msg-kpi__num" data-count="@Model.AllCount">@Model.AllCount</span>
                <span class="msg-kpi__label">@Localizer["PayTotalOrders"]</span>
            </a>

            <a class="msg-kpi msg-kpi--refunded tg-card tg-card--coral" asp-action="Index" asp-route-status="@AdminPaymentsPage.Refunded" asp-fragment="msgPayDesk" data-tilt="6">
                <i class="bi bi-arrow-counterclockwise msg-kpi__icon" aria-hidden="true"></i>
                <span class="msg-kpi__num" data-count="@Model.RefundedCount">@Model.RefundedCount</span>
                <span class="msg-kpi__label">@Localizer["PayTotalRefunded"]</span>
            </a>

            <a class="msg-kpi msg-kpi--pending tg-card tg-card--lilac" asp-action="Index" asp-route-status="@AdminPaymentsPage.Pending" asp-fragment="msgPayDesk" data-tilt="4">
                <i class="bi bi-hourglass-split msg-kpi__icon" aria-hidden="true"></i>
                <span class="msg-kpi__num" data-count="@Model.PendingCount">@Model.PendingCount</span>
                <span class="msg-kpi__label">@Localizer["PayTotalPending"]</span>
            </a>
        </div>

        @* ===== Desk: status filter + search (in all payments, on the server) + one page of the list ===== *@
        <div class="msg-desk tg-card tg-card--pop" id="msgPayDesk">
            <div class="msg-desk__bar">
                <nav class="tg-switch msg-desk__filters" aria-label="@Localizer["IStatus"]">
                    <a asp-action="Index" asp-route-q="@search" asp-fragment="msgPayDesk" class="@Pill(null)" aria-current="@Current(null)">
                        @Localizer["PayFilterAll"]<span class="msg-pill-n">@Model.AllCount</span>
                    </a>
                    <a asp-action="Index" asp-route-status="@AdminPaymentsPage.Paid" asp-route-q="@search" asp-fragment="msgPayDesk" class="@Pill(AdminPaymentsPage.Paid)" aria-current="@Current(AdminPaymentsPage.Paid)">
                        <i class="bi bi-check-circle-fill" aria-hidden="true"></i>@Localizer["PayStatusPaid"]<span class="msg-pill-n">@Model.PaidCount</span>
                    </a>
                    <a asp-action="Index" asp-route-status="@AdminPaymentsPage.Refunded" asp-route-q="@search" asp-fragment="msgPayDesk" class="@Pill(AdminPaymentsPage.Refunded)" aria-current="@Current(AdminPaymentsPage.Refunded)">
                        <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>@Localizer["PayStatusRefunded"]<span class="msg-pill-n">@Model.RefundedCount</span>
                    </a>
                    <a asp-action="Index" asp-route-status="@AdminPaymentsPage.Pending" asp-route-q="@search" asp-fragment="msgPayDesk" class="@Pill(AdminPaymentsPage.Pending)" aria-current="@Current(AdminPaymentsPage.Pending)">
                        <i class="bi bi-hourglass-split" aria-hidden="true"></i>@Localizer["PayStatusPending"]<span class="msg-pill-n">@Model.PendingCount</span>
                    </a>
                    @if (Model.OtherCount > 0)
                    {
                        <a asp-action="Index" asp-route-status="@AdminPaymentsPage.Other" asp-route-q="@search" asp-fragment="msgPayDesk" class="@Pill(AdminPaymentsPage.Other)" aria-current="@Current(AdminPaymentsPage.Other)">
                            @Localizer["PayStatusOther"]<span class="msg-pill-n">@Model.OtherCount</span>
                        </a>
                    }
                </nav>

                <form class="msg-search" method="get" asp-action="Index" asp-fragment="msgPayDesk" role="search">
                    @if (status != null)
                    {
                        <input type="hidden" name="status" value="@status" />
                    }
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <label for="payQ" class="visually-hidden">@Localizer["PaySearch"]</label>
                    <input id="payQ" type="search" name="q" value="@search" class="form-control msg-search__input" placeholder="@Localizer["PaySearch"]" autocomplete="off" />
                    <button type="submit" class="btn btn-primary btn-sm msg-search__go">@Localizer["PaySearchGo"]</button>
                </form>

                <span class="msg-desk__shown">
                    @Localizer["PayShown", payments.TotalItemCount, Model.AllCount]
                    @if (search != null)
                    {
                        <a asp-action="Index" asp-route-status="@status" asp-fragment="msgPayDesk" class="msg-desk__clear">@Localizer["PaySearchClear"]</a>
                    }
                </span>
            </div>

            <div class="msg-desk__scroll">
                @if (!payments.Any())
                {
                    <div class="msg-desk__none">
                        <i class="bi bi-search" aria-hidden="true"></i>@Localizer["PayNoMatch"]
                    </div>
                }
                else
                {
                    <table class="table table-hover align-middle mb-0 msg-paytable">
                        <thead>
                            <tr>
                                <th scope="col">@Localizer["IOrder"]</th>
                                <th scope="col">@Localizer["IUser"]</th>
                                <th scope="col">@Localizer["ITournament"]</th>
                                <th scope="col">@Localizer["ITeam"]</th>
                                <th scope="col">@Localizer["IAmount"]</th>
                                <th scope="col">@Localizer["IStatus"]</th>
                                <th scope="col">@Localizer["IPaidOn"]</th>
                                <th scope="col" class="text-center">@Localizer["IAction"]</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var p in payments)
                            {
                                var st = (p.Status ?? string.Empty).ToLowerInvariant();
                                var chipClass = st switch
                                {
                                    "paid" => "tg-chip--green",
                                    "refunded" => "tg-chip--coral",
                                    "pending" => "tg-chip--sun",
                                    "refundpending" => "tg-chip--sky",
                                    "refundfailed" => "tg-chip--coral",
                                    _ => ""
                                };
                                var chipIcon = st switch
                                {
                                    "paid" => "bi-check-circle-fill",
                                    "refunded" => "bi-arrow-counterclockwise",
                                    "pending" => "bi-hourglass-split",
                                    "refundpending" => "bi-arrow-repeat",
                                    "refundfailed" => "bi-x-octagon-fill",
                                    "expired" => "bi-clock-history",
                                    _ => "bi-circle"
                                };

                                <tr>
                                    <th scope="row" class="msg-pay-id">#@p.Id</th>

                                    <td data-label="@Localizer["IUser"]">
                                        @if (p.UserName != null)
                                        {
                                            <span class="msg-who">
                                                <span class="msg-who__name">@p.UserName</span>
                                                <a class="msg-who__mail" href="mailto:@p.UserEmail">@p.UserEmail</a>
                                            </span>
                                        }
                                        else
                                        {
                                            @* The account was deleted; the payment stays as an accounting record. *@
                                            <span class="msg-pay-none" title="@p.UserId">@Localizer["PayDeletedUser"]</span>
                                        }
                                    </td>

                                    <td data-label="@Localizer["ITournament"]">
                                        @if (p.TournamentDeleted)
                                        {
                                            @* The tournament was deleted; the payment stays as a record. *@
                                            <span class="msg-ref">
                                                <i class="bi bi-trophy" aria-hidden="true"></i>
                                                <span>@Localizer["PayDeletedTournament"] · @p.City @p.TournamentStartDate?.ToString("dd.MM.yyyy")</span>
                                            </span>
                                        }
                                        else
                                        {
                                            <a class="msg-ref" asp-controller="Tournament" asp-action="Details" asp-route-id="@p.TournamentId" asp-route-information="@p.GetInformation()">
                                                <i class="bi bi-trophy-fill" aria-hidden="true"></i>
                                                <span>@p.City · @p.TournamentStartDate?.ToString("dd.MM.yyyy")</span>
                                            </a>
                                        }
                                    </td>

                                    <td data-label="@Localizer["ITeam"]">
                                        <span class="msg-ref">
                                            <i class="bi bi-shield-fill" aria-hidden="true"></i>
                                            <span>@(p.TeamName ?? "—")</span>
                                        </span>
                                    </td>

                                    <td data-label="@Localizer["IAmount"]">
                                        <span class="msg-amount">@p.Amount.ToString("N2") €</span>
                                    </td>

                                    <td data-label="@Localizer["IStatus"]">
                                        <span class="tg-chip @chipClass">
                                            <i class="bi @chipIcon" aria-hidden="true"></i>
                                            @StatusLabel(p.Status ?? string.Empty)
                                        </span>

                                        @if (p.TeamLeft)
                                        {
                                            @* Paid, but the team left: the coach may ask for the money back. *@
                                            <span class="tg-chip" title="@Localizer["PayTeamLeftHint"]">
                                                <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                                @Localizer["PayTeamLeft"]
                                            </span>
                                        }
                                    </td>

                                    <td data-label="@Localizer["IPaidOn"]">
                                        <span class="msg-pay-date">@(p.PaidOnUtc.HasValue ? BgTime.FromUtc(p.PaidOnUtc.Value).ToString("dd.MM.yyyy HH:mm") : "-")</span>
                                    </td>

                                    <td class="msg-pay-action text-md-center" data-label="@Localizer["IAction"]">
                                        @if (p.CanRefund)
                                        {
                                            <form asp-action="Refund"
                                                  method="post"
                                                  data-confirm="@Localizer["PayRefundConfirm"]">
                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="orderId" value="@p.Id" />
                                                <input type="hidden" name="page" value="@payments.PageNumber" />
                                                <input type="hidden" name="status" value="@status" />
                                                <input type="hidden" name="q" value="@search" />

                                                <button type="submit" class="btn btn-sm btn-outline-dark msg-refund">
                                                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                                    @Localizer["IRefund"]
                                                </button>
                                            </form>
                                        }
                                        else if (p.Status == "Paid")
                                        {
                                            <span class="msg-pay-none" title="@Localizer["RefundTournamentStarted"]">
                                                <i class="bi bi-lock-fill" aria-hidden="true"></i> @Localizer["RefundStartedShort"]
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="msg-pay-none">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @if (payments.PageCount > 1)
            {
                <nav class="tn-pager msg-desk__pager" aria-label="@Localizer["PayTitle"]">
                    @Html.PagedListPager(
                        payments,
                        page => Url.Action("Index", new { page, status, q = search }) + "#msgPayDesk",
                        new PagedListRenderOptions
                        {
                            LiElementClasses = new[] { "page-item" },
                            PageClasses = new[] { "page-link" }
                        }
                    )
                </nav>
            }
        </div>
    }

</section>
